# Clave para descargar el xlsx del día desde /api/registro/export?date=AAAA-MM-DD&key=...
# Reemplaza el valor y copia este archivo como .env.local
EXPORT_ACCESS_KEY=cambia-esta-clave

# Almacén principal de registros: hoja de cálculo de Google.
# La URL sale de Apps Script al publicar (Implementar > Nueva implementación),
# y el secreto es el mismo que pusiste en scripts/google-apps-script.gs
REGISTROS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXX/exec
REGISTROS_WEBHOOK_SECRET=cambia-esta-contrasena
